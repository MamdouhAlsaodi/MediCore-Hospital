# Non-secret variable names for local review; provide values outside the repository.
HOSPITAL_JWT_SECRET=<set-at-runtime>
HOSPITAL_ADMIN_PASSWORD=<set-at-runtime>
DB_URL=<optional-postgresql-jdbc-url>
DB_USER=<optional-postgresql-user>
DB_PASSWORD=<optional-postgresql-password>
REVIEW_BIND_HOST=<operator-supplied-tailnet-interface-address>
# Optional demo-data flag (non-secret): leave false unless seeding a local demo.
MEDICORE_DEMO_SEED=false
# Opt-in review-account bootstrap (training/review only, non-secret flag):
# leave false unless a local review backend needs the doctor/nurse accounts.
MEDICORE_REVIEW_ACCOUNTS_ENABLED=false
HOSPITAL_REVIEW_DOCTOR_PASSWORD=<set-at-runtime-when-enabled>
HOSPITAL_REVIEW_NURSE_PASSWORD=<set-at-runtime-when-enabled>
#
# Phase 4 Compose review stack (plan Task 6): required before
# `docker compose up` unless a local untracked .env or the exporting shell
# provides them. Compose fails closed when a required variable is missing;
# there are no fallback passwords anywhere.
#   REVIEW_DB_NAME                 PostgreSQL database name (disposable review database)
#   REVIEW_DB_USER                 PostgreSQL review-role user name
#   REVIEW_DB_PASSWORD             PostgreSQL review-role password (runtime-only)
# Optional with safe defaults in compose.yaml:
#   REVIEW_PG_HOST_PORT            Loopback host port for PostgreSQL (default 55432)
#   REVIEW_API_HOST_PORT           Loopback host port for the backend API (default 5501)
#   REVIEW_WEB_HOST_PORT           Loopback host port for the SPA (default 5502)
